# Development configuration for Practice Activity.
#
# Copy to .env.local (git-ignored) and fill in a Practice Log you are happy to
# point a work-in-progress build at. This file only affects `pnpm dev`; a
# packaged app ignores it entirely.
#
#   cp .env.example .env.local
#
# Which Practice Log `pnpm dev` should open. Leave unset to use whatever the
# dev setup wizard last saved.
#
# Override for a single run without editing this file:
#
#   PRACTICE_SHEET_URL="https://docs.google.com/spreadsheets/d/other/edit" pnpm dev
#
# While a URL is set here or in the environment, it wins for the whole run:
# "Change Practice Log" still writes to dev settings, but the override is what
# loads. Unset it to exercise the first-run setup wizard.

PRACTICE_SHEET_URL=""
